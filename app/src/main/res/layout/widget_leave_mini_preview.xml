<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_small_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_leave_card" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="0dp" android:paddingBottom="0dp">
